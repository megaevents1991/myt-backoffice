# ============================================================================
# Amadeus Enterprise REST API — backoffice (myt---backoffice)
# ----------------------------------------------------------------------------
# Source of values: Amadeus Enterprise workspace
#   https://developers.amadeus.com/my-enterprise-ws/rest  ->  "Mega events" REST app
#
# Copy the lines below into your real .env.local and fill in the values.
# DO NOT commit real secrets. This .example file is safe to commit.
# Backoffice uses the NEXT_SECRET_ prefix convention.
# ============================================================================

# Environment switch:
#   test       = Amadeus sandbox host (use while developing / before QA approval)
#   enterprise = production host (only after Amadeus promotes the app to Production)
NEXT_SECRET_AMADEUS_ENV=test

# Hosts. Leave as-is for the sandbox. For Enterprise, paste the host(s) shown on
# the app detail page (auth host and api host are usually the same).
NEXT_SECRET_AMADEUS_AUTH_HOST=https://test.api.amadeus.com
NEXT_SECRET_AMADEUS_API_HOST=https://test.api.amadeus.com

# Credentials — from the "Mega events" app detail page:
#   API Key    -> NEXT_SECRET_AMADEUS_CLIENT_ID
#   API Secret -> NEXT_SECRET_AMADEUS_CLIENT_SECRET  (click reveal/show on the page)
NEXT_SECRET_AMADEUS_CLIENT_ID=
NEXT_SECRET_AMADEUS_CLIENT_SECRET=

# Office ID — only if the Enterprise app scopes requests by office.
# Candidate from the workspace: GOT 259889. Leave blank if not required.
NEXT_SECRET_AMADEUS_OFFICE_ID=
