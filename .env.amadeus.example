# ============================================================================
# Amadeus Enterprise REST API — backoffice (myt---backoffice)
# ----------------------------------------------------------------------------
# Source of values: Amadeus Enterprise workspace
#   https://developers.amadeus.com/my-enterprise-ws/rest  ->  "Mega events" REST app
#
# Copy the lines below into your real .env.local and fill in the values.
# DO NOT commit real secrets. This .example file is safe to commit.
# Backoffice uses the NEXT_SECRET_ prefix convention.
# ============================================================================

# Environment switch:
#   test       = Enterprise sandbox gateway (test.travel.api.amadeus.com)
#   enterprise = production gateway (travel.api.amadeus.com) — LIVE since 2026-07-18
NEXT_SECRET_AMADEUS_ENV=enterprise

# Host overrides — optional; NEXT_SECRET_AMADEUS_ENV already picks the right default.
# Keep explicit for clarity:
NEXT_SECRET_AMADEUS_AUTH_HOST=https://travel.api.amadeus.com
NEXT_SECRET_AMADEUS_API_HOST=https://travel.api.amadeus.com

# Credentials — Production keys from the "Mega events" app detail page.
# NEW_ prefix (mirrors myt-main's NEW_AMADEUS_*) keeps them separate from the
# legacy NEXT_SECRET_AMADEUS_* self-service pair:
#   API Key    -> NEW_NEXT_SECRET_AMADEUS_CLIENT_ID
#   API Secret -> NEW_NEXT_SECRET_AMADEUS_CLIENT_SECRET  (click reveal/show on the page)
NEW_NEXT_SECRET_AMADEUS_CLIENT_ID=
NEW_NEXT_SECRET_AMADEUS_CLIENT_SECRET=

# NOTE: no Office ID env — the office/PCC is bound to the OAuth credential on
# Amadeus's side; sending X-Amadeus-Office-Id trips error 2668 on this gateway.
