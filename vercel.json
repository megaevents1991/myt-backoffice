{
  "crons": [
    {
      "path": "/api/cron/partnerMonthlyReport",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/monthlyTournamentsSync",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/dailyEventsSync",
      "schedule": "1 0 * * *"
    },
    {
      "path": "/api/cron/dailyLiveEventsSync",
      "schedule": "0 0,12 * * *"
    },
    {
      "path": "/api/cron/ticketPriceSync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/nightlyTixstockSync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/nightlyTixstockPriceSync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/weeklyFeedHealth",
      "schedule": "0 6 * * 1"
    }
  ],
  "functions": {
    "app/api/validate-airline/route.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "app/api/quotes/[id]/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "app/api/sports-events/sync/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/live-events/sync/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/cron/*/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/cron/partnerMonthlyReport/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "app/api/cron/nightlyTixstockSync/route.ts": {
      "memory": 1024,
      "maxDuration": 800
    },
    "app/api/cron/nightlyTixstockPriceSync/route.ts": {
      "memory": 1024,
      "maxDuration": 800
    }
  },
  "routes": [
    {
      "src": "/api/validate-airline",
      "dest": "api/validate-airline.js"
    }
  ],
  "headers": [
    {
      "source": "/api/proxy-image",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "NPM_CONFIG_USER_AGENT": "npm"
    }
  }
}
